      "arguments": "{\"files\":[{\"path\":\"app.js\",\"content\":\"import * as THREE from 'three';\\nconst canvas=document.querySelector('#view'),renderer=new THREE.WebGLRenderer({canvas,antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.05;\\nconst scene=new THREE.Scene();scene.background=new THREE.Color('#c3c2cd');const aspect=innerWidth/innerHeight;const camera=new THREE.OrthographicCamera(-9.7*aspect,9.7*aspect,9.7,-9.7,.1,150);let az=.12,el=.79,dist=34,target=new THREE.Vector3(0,0,0);function cam(){camera.position.set(target.x+dist*Math.cos(el)*Math.sin(az),dist*Math.sin(el),target.z+dist*Math.cos(el)*Math.cos(az));camera.lookAt(target);camera.updateProjectionMatrix()}cam();\\nscene.add(new THREE.HemisphereLight(0xffffff,0x777482,1.65));let sun=new THREE.DirectionalLight(0xffffff,2.3);sun.position.set(-9,22,12);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-22;sun.shadow.camera.right=22;sun.shadow.camera.top=22;sun.shadow.camera.bottom=-22;sun.shadow.bias=-.0004;scene.add(sun);\\nfunction groundTex(){let c=document.createElement('canvas');c.width=c.height=512;let x=c.getContext('2d');x.fillStyle='#c9c8d1';x.fillRect(0,0,512,512);for(let i=0;i<15000;i++){let a=Math.random()*512,b=Math.random()*512;x.fillStyle=`rgba(${Math.random()<.5?'65,65,76':'255,255,255'},${Math.random()*.035})`;x.fillRect(a,b,1,1)}for(let i=0;i<90;i++){let a=Math.random()*512,b=Math.random()*512;x.beginPath();x.moveTo(a,b);for(let j=0;j<8;j++){a+=(Math.random()-.5)*9;b+=(Math.random()-.5)*8;x.lineTo(a,b)}x.strokeStyle='rgba(72,72,83,.14)';x.lineWidth=.5;x.stroke()}let t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(8,8);t.colorSpace=THREE.SRGBColorSpace;return t}\\nlet floor=new THREE.Mesh(new THREE.PlaneGeometry(300,300),new THREE.MeshStandardMaterial({map:groundTex(),roughness:1}));floor.rotation.x=-Math.PI/2;floor.position.y=-.3;floor.receiveShadow=true;scene.add(floor);\\nconst N=24,cell=.72,boardSize=N*cell;let board=new THREE.Group();scene.add(board);let base=new THREE.Mesh(new THREE.BoxGeometry(boardSize,.22,boardSize),new THREE.MeshStandardMaterial({color:0xb9bac8,roughness:.87}));base.position.y=-.13;base.receiveShadow=true;base.castShadow=true;board.add(base);const studGeo=new THREE.CylinderGeometry(.19,.19,.095,20);const studMat=new THREE.MeshStandardMaterial({color:0xe2e0e9,roughness:.58});for(let i=0;i<N;i++)for(let j=0;j<N;j++){let s=new THREE.Mesh(studGeo,studMat);s.position.set((i-(N-1)/2)*cell,-.005,(j-(N-1)/2)*cell);s.castShadow=true;s.receiveShadow=true;board.add(s)}\\nconst palette=['#ed4c48','#f39a43','#f7ca43','#5bc879','#45bde1','#5278d5','#a23bc9','#30313a'];let color=palette[0],w=2,d=2,mode='build',bricks=[];const ray=new THREE.Raycaster(),mouse=new THREE.Vector2(),groundPlane=new THREE.Plane(new THREE.Vector3(0,1,0),0);let preview=null,hovered=null;\\nfunction makeBrick(x,z,width,depth,y,col,ghost=false){let g=new THREE.Group();let mat=new THREE.MeshStandardMaterial({color:col,roughness:.39,metalness:.02,transparent:ghost,opacity:ghost?.43:1,depthWrite:!ghost});let body=new THREE.Mesh(new THREE.BoxGeometry(width*cell-.035,.82,depth*cell-.035),mat);body.position.y=y+.41;body.castShadow=!ghost;body.receiveShadow=true;g.add(body);for(let i=0;i<width;i++)for(let j=0;j<depth;j++){let s=new THREE.Mesh(new THREE.CylinderGeometry(.22,.22,.13,20),mat);s.position.set((i-(width-1)/2)*cell,y+.885,(j-(depth-1)/2)*cell);s.castShadow=!ghost;g.add(s)}g.position.set(x,0,z);g.userData={x,z,w:width,d:depth,y,color:col};return g}\\nfunction disposePreview(){if(preview){scene.remove(preview);preview=null}}function cursorPoint(e){let r=canvas.getBoundingClientRect();mouse.x=(e.clientX/r.width)*2-1;mouse.y=-(e.clientY/r.height)*2+1;ray.setFromCamera(mouse,camera);let p=new THREE.Vector3();ray.ray.intersectPlane(groundPlane,p);return p}function cellCenter(v){let k=Math.round(v/cell+(N-1)/2);k=Math.max(0,Math.min(N-1,k));return(k-(N-1)/2)*cell}function snap(p){return [cellCenter(Math.round((p.x/cell+(N-1)/2)-(w-1)/2)*cell),cellCenter(Math.round((p.z/cell+(N-1)/2)-(d-1)/2)*cell)]}function footprintHeight(x,z){let top=0;for(const b of bricks){let u=b.mesh.userData;if(Math.abs(x-u.x)<(w+u.w)*cell/2-.02&&Math.abs(z-u.z)<(d+u.d)*cell/2-.02)top=Math.max(top,u.y+.82)}return top}function updatePreview(e){let p=cursorPoint(e),[x,z]=snap(p),y=footprintHeight(x,z);if(preview)scene.remove(preview);preview=makeBrick(x,z,w,d,y,color,true);scene.add(preview)}\\nlet lastMouse={x:innerWidth/2,y:innerHeight/2},dragging=false;canvas.addEventListener('pointermove',e=>{if(mode==='orbit'&&dragging){let dx=e.clientX-lastMouse.x,dy=e.clientY-lastMouse.y;az-=dx*.008;el=Math.max(.2,Math.min(1.35,el+dy*.007));cam()}else if(mode==='build')updatePreview(e);else if(mode==='erase'){cursorPoint(e);let hit=ray.intersectObjects(bricks.flatMap(b=>b.mesh.children),false)[0];if(hovered)hovered.traverse(o=>{if(o.material?.emissive)o.material.emissive.set(0)});hovered=hit?.object.parent||null;if(hovered)hovered.traverse(o=>{if(o.material?.emissive)o.material.emissive.set('#743c3c')})}lastMouse={x:e.clientX,y:e.clientY}});canvas.addEventListener('pointerdown',e=>{if(mode==='orbit'){dragging=true;canvas.setPointerCapture(e.pointerId);lastMouse={x:e.clientX,y:e.clientY}}});canvas.addEventListener('pointerup',()=>dragging=false);\\ncanvas.addEventListener('click',e=>{if(mode==='build'){let p=cursorPoint(e),[x,z]=snap(p),y=footprintHeight(x,z),mesh=makeBrick(x,z,w,d,y,color);bricks.push({mesh});scene.add(mesh);updatePreview(e)}else if(mode==='erase'){cursorPoint(e);let h=ray.intersectObjects(bricks.flatMap(b=>b.mesh.children),false)[0];if(h){let group=h.object.parent,idx=bricks.findIndex(b=>b.mesh===group);if(idx>=0){scene.remove(group);bricks.splice(idx,1)}}}});\\nconst colors=document.querySelector('.colors');palette.forEach((c,i)=>{let b=document.createElement('button');b.className='swatch'+(!i?' selected':'');b.style.background=c;b.title=c;b.onclick=()=>{color=c;document.querySelectorAll('.swatch').forEach(q=>q.classList.remove('selected'));b.classList.add('selected')};colors.appendChild(b)});for(let i=1;i<=6;i++){for(const s of [document.querySelector('#width'),document.querySelector('#depth')]){let o=document.createElement('option');o.value=i;o.textContent=i;s.append(o)}}document.querySelector('#width').value=2;document.querySelector('#depth').value=2;document.querySelector('#width').onchange=e=>{w=+e.target.value;updatePreviewAtLast()};document.querySelector('#depth').onchange=e=>{d=+e.target.value;updatePreviewAtLast()};function updatePreviewAtLast(){if(mode==='build')updatePreview({clientX:lastMouse.x,clientY:lastMouse.y})}document.querySelector('#swap').onclick=()=>{[w,d]=[d,w];document.querySelector('#width').value=w;document.querySelector('#depth').value=d;updatePreviewAtLast()};document.querySelectorAll('.mode').forEach(b=>b.onclick=()=>{mode=b.dataset.mode;document.querySelectorAll('.mode').forEach(q=>q.classList.toggle('active',q===b));disposePreview();canvas.style.cursor=mode==='orbit'?'grab':mode==='erase'?'crosshair':'default'});\\nconst modal=document.querySelector('#modal');document.querySelector('#clear').onclick=()=>modal.classList.add('show');function close(){modal.classList.remove('show')}document.querySelector('#cancel').onclick=document.querySelector('#x').onclick=close;document.querySelector('#confirm').onclick=()=>{bricks.forEach(b=>scene.remove(b.mesh));bricks=[];close();if(mode==='build')updatePreviewAtLast()};modal.onclick=e=>{if(e.target===modal)close()};document.querySelector('#undo').onclick=()=>{let b=bricks.pop();if(b)scene.remove(b.mesh)};let playing=false;document.querySelector('#play').onclick=()=>{playing=!playing;document.querySelector('#play').textContent=playing?'Ⅱ':'▶';document.querySelector('#toolbar').style.opacity=playing?'.18':'1';document.querySelector('#toolbar').style.pointerEvents=playing?'none':'auto';if(playing){mode='orbit';document.querySelectorAll('.mode').forEach(b=>b.classList.toggle('active',b.dataset.mode==='orbit'));disposePreview()}};window.addEventListener('keydown',e=>{if(e.key.toLowerCase()==='s')document.querySelector('#swap').click();if(e.key==='Escape')close()});function resize(){renderer.setSize(innerWidth,innerHeight);camera.left=-9.7*innerWidth/innerHeight;camera.right=9.7*innerWidth/innerHeight;camera.top=9.7;camera.bottom=-9.7;camera.updateProjectionMatrix()}window.addEventListener('resize',resize);let starter=makeBrick(0,0,2,2,0,palette[0]);bricks.push({mesh:starter});scene.add(starter);let clock=new THREE.Clock();function animate(){requestAnimationFrame(animate);if(playing){az+=.002;cam()}renderer.render(scene,camera)}animate();\"} ,{\"path\":\"style.css\",\"content\":\"*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:Inter,Arial,sans-serif}#view{position:absolute;inset:0;width:100%;height:100%;display:block;background:#c6c5d0}.left{position:absolute;top:17px;left:11px;display:flex;flex-direction:column;gap:12px}.mode{border:0;width:48px;height:48px;border-radius:50%;background:#777983d9;color:#fff;font-size:23px;cursor:pointer;box-shadow:0 1px 3px #777}.mode.active{background:#08090d}.sound{position:absolute;right:25px;top:28px;color:#fff;font-size:15px;opacity:.85}.toolbar{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);height:59px;border-radius:34px;background:#111722f5;box-shadow:0 3px 8px #6667;display:flex;align-items:center;padding:0 22px;gap:7px;color:#dce1ec;z-index:2}.toolbar button{height:36px;min-width:26px;border:0;background:transparent;color:#dce1ec;font-size:20px;cursor:pointer;border-radius:6px}.toolbar button:hover{background:#ffffff20}.toolbar button:disabled{opacity:.3}.toolbar i{height:26px;width: